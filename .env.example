# Audio streaming prototype environment (WebSocket transport)

WS_HOST=127.0.0.1
WS_PORT=8765
WS_RECONNECT_DELAY=2.0

SPEAKER1_PATH=/path/to/speaker_1.wav
SPEAKER2_PATH=/path/to/speaker_2.wav

RECONNECT_DELAY_SECONDS=2.0
LOG_LEVEL=INFO
BUFFER_TIMEOUT_SECONDS=35
VAD_SILENCE_THRESHOLD_MS=700
VAD_MIN_SPEECH_SECONDS=2.0
HF_TOKEN=HF_TOKEN_PLACEHOLDER